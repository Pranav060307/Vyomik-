# VYOMIK Gmail Watcher Environment Configuration
NODE_ENV=production

# Redis connection URL (Upstash or local)
REDIS_URL=redis://localhost:6379

# Gmail Account & Google App Password
GMAIL_USER=alerts.vyomik@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Target VYOMIK API URL (Backend endpoint)
