# ==============================================================================
# VYOMIK Root Environment Variables Template
# Copy to .env for Docker Compose or local runs
# ==============================================================================

# Application Environment
ENVIRONMENT=development
STORE_MODE=coming_soon  # "coming_soon" | "live"

# Pre-Launch Coming Soon Gate (Confirm exact launch time with CEO)
LAUNCH_AT=2026-11-08T00:00:00+05:30
LAUNCH_GATE_ENABLED=true
PREVIEW_KEY=vyomik_team_preview_2026
CONTACT_EMAIL=simplyvyomik@gmail.com
INSTAGRAM_URL=https://www.instagram.com/simplyvyomik

# Security
SECRET_KEY=change_me_super_secret_production_key_min_32_chars_123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL)
POSTGRES_USER=vyomik
POSTGRES_PASSWORD=vyomik_secret_dev_pass
POSTGRES_DB=vyomik_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://vyomik:vyomik_secret_dev_pass@localhost:5432/vyomik_db
SYNC_DATABASE_URL=postgresql://vyomik:vyomik_secret_dev_pass@localhost:5432/vyomik_db

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Payment Provider Abstraction
# Options: "mock" (default until gateway chosen), "razorpay", "cashfree", "stripe"
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_AUTO_SUCCESS=true

# Qikink Integration
# Options: "mock" (default, zero network calls), "sandbox", "live"
QIKINK_MODE=mock
QIKINK_CLIENT_ID=
QIKINK_API_KEY=
QIKINK_WEBHOOK_SECRET=
QIKINK_WALLET_MIN_THRESHOLD_PAISE=1000000  # Rs. 10,000 threshold alert

# Business / Pricing Rules (in Paise, INR)
FREE_SHIPPING_THRESHOLD_PAISE=149900  # Free shipping over Rs. 1,499
DEFAULT_SHIPPING_FEE_PAISE=9900      # Rs. 99 flat shipping
COD_AVAILABLE=true
COD_FEE_PAISE=4900                  # Rs. 49 flat COD fee

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

