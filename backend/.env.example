# Backend Environment Variables
ENVIRONMENT=development
STORE_MODE=coming_soon  # "coming_soon" | "live"

# Security
SECRET_KEY=change_me_super_secret_production_key_min_32_chars_123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql+asyncpg://vyomik:vyomik_secret_dev_pass@localhost:5432/vyomik_db
SYNC_DATABASE_URL=postgresql://vyomik:vyomik_secret_dev_pass@localhost:5432/vyomik_db

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Payment Gateway Provider Abstraction
# Default: "mock" (No real payment credentials needed)
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_AUTO_SUCCESS=true

# Qikink Integration Settings
# Options: "mock" | "sandbox" | "live"
QIKINK_MODE=mock
QIKINK_CLIENT_ID=
QIKINK_API_KEY=
QIKINK_WEBHOOK_SECRET=
QIKINK_WALLET_MIN_THRESHOLD_PAISE=1000000

# Pricing in Paise (1 INR = 100 Paise)
FREE_SHIPPING_THRESHOLD_PAISE=149900
DEFAULT_SHIPPING_FEE_PAISE=9900
COD_AVAILABLE=true
COD_FEE_PAISE=4900
